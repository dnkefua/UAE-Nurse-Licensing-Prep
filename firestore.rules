rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function member() {
      return signedIn() && (admin()
        || (exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
          && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.status == 'active'));
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function shortText(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function id(value) { return shortText(value, 1, 128) && value.matches('^[a-zA-Z0-9_-]+$'); }
    function date(value) { return shortText(value, 1, 64); }
    function exam(value) { return value in ['DHA', 'MOH', 'HAAD_DOH']; }
    function ownListChange(before, after, max) {
      return after is list && after.size() <= max && after.toSet().size() == after.size()
        && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }

    function profile(d) {
      return d.keys().hasOnly(['uid', 'displayName', 'targetExam', 'examDate', 'registeredForExam',
          'studyHoursGoal', 'completedMilestones', 'currentStreak', 'createdAt', 'updatedAt', 'lastStudyDate'])
        && d.uid == request.auth.uid && shortText(d.displayName, 1, 100) && exam(d.targetExam)
        && shortText(d.examDate, 0, 64) && d.registeredForExam is bool
        && d.studyHoursGoal is int && d.studyHoursGoal >= 0 && d.studyHoursGoal <= 1000
        && d.completedMilestones is list && d.completedMilestones.size() <= 30
        && d.completedMilestones.toSet().hasOnly(['1_degree_verify', '2_good_standing', '3_dataflow',
          '4_eligibility', '5_prometric_book', '6_exam_sit'])
        && d.currentStreak is int && d.currentStreak >= 0 && d.currentStreak <= 100000
        && date(d.createdAt) && date(d.updatedAt)
        && (!('lastStudyDate' in d) || (d.lastStudyDate is string && d.lastStudyDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }
    match /userProfiles/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && profile(request.resource.data);
      allow update: if owner(uid) && profile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      // Account deletion must use the authenticated API so related data is also removed.
      allow delete: if false;
    }
    match /memberships/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }

    function post(d, postId) {
      return d.keys().hasOnly(['id', 'title', 'content', 'authorId', 'authorName', 'category',
          'commentsCount', 'likes', 'createdAt', 'updatedAt'])
        && d.id == postId && id(d.id) && shortText(d.authorId, 1, 128)
        && shortText(d.title, 1, 200) && shortText(d.content, 1, 5000)
        && shortText(d.authorName, 1, 100)
        && d.category in ['Licensing', 'Study Notes', 'Exam Tips', 'Mentorship']
        && d.commentsCount is int && d.commentsCount >= 0 && d.commentsCount <= 100000
        && d.likes is list && d.likes.size() <= 1000 && d.likes.toSet().size() == d.likes.size()
        && date(d.createdAt) && date(d.updatedAt);
    }
    match /forumPosts/{postId} {
      allow read: if member();
      allow create: if member() && post(request.resource.data, postId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.commentsCount == 0 && request.resource.data.likes.size() == 0;
      allow update: if member() && post(request.resource.data, postId)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && ((request.auth.uid == resource.data.authorId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'category', 'updatedAt']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'updatedAt'])
            && ownListChange(resource.data.likes, request.resource.data.likes, 1000)));
      // Comment counts are server-maintained; clients cannot forge aggregate counts.
      allow delete: if member() && request.auth.uid == resource.data.authorId;
    }
    function comment(d, postId, commentId) {
      return d.keys().hasOnly(['id', 'postId', 'content', 'authorId', 'authorName', 'createdAt'])
        && d.id == commentId && id(d.id) && d.postId == postId
        && shortText(d.content, 1, 1500) && shortText(d.authorName, 1, 100)
        && d.authorId == request.auth.uid && date(d.createdAt);
    }
    match /forumPosts/{postId}/comments/{commentId} {
      allow read: if member();
      allow create: if member() && exists(/databases/$(database)/documents/forumPosts/$(postId))
        && comment(request.resource.data, postId, commentId);
      allow update: if member() && resource.data.authorId == request.auth.uid
        && comment(request.resource.data, postId, commentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content']);
      allow delete: if member() && resource.data.authorId == request.auth.uid;
    }

    function session(d, sessionId) {
      return d.keys().hasOnly(['id', 'title', 'dateTime', 'duration', 'topic', 'hostId', 'hostName',
          'attendees', 'isExpertQA', 'expertName', 'createdAt'])
        && d.id == sessionId && id(d.id) && shortText(d.title, 1, 200) && date(d.dateTime)
        && d.duration is int && d.duration >= 5 && d.duration <= 480
        && shortText(d.topic, 1, 100) && shortText(d.hostId, 1, 128) && shortText(d.hostName, 1, 100)
        && d.attendees is list && d.attendees.size() <= 100 && d.attendees.toSet().size() == d.attendees.size()
        && d.isExpertQA is bool && date(d.createdAt)
        && (!('expertName' in d) || shortText(d.expertName, 1, 100));
    }
    match /studySessions/{sessionId} {
      allow read: if member();
      allow create: if member() && session(request.resource.data, sessionId)
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.attendees.toSet().hasOnly([request.auth.uid])
        && (request.resource.data.isExpertQA == false || admin());
      allow update: if member() && session(request.resource.data, sessionId)
        && ((request.auth.uid == resource.data.hostId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'dateTime', 'duration', 'topic']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees'])
            && ownListChange(resource.data.attendees, request.resource.data.attendees, 100)));
      allow delete: if member() && resource.data.hostId == request.auth.uid;
    }

    function attempt(d, attemptId) {
      return d.keys().hasOnly(['id', 'userId', 'examType', 'score', 'correctAnswers', 'totalQuestions', 'completedAt', 'assessmentVersion'])
        && d.id == attemptId && id(d.id) && d.userId == request.auth.uid && exam(d.examType)
        && d.score is number && d.score >= 0 && d.score <= 100
        && d.correctAnswers is int && d.correctAnswers >= 0
        && d.totalQuestions is int && d.totalQuestions > 0 && d.totalQuestions <= 1000
        && d.correctAnswers <= d.totalQuestions && date(d.completedAt)
        && (!('assessmentVersion' in d) || d.assessmentVersion == 'practice-v2');
    }
    match /testAttempts/{attemptId} {
      allow read: if member() && resource.data.userId == request.auth.uid;
      allow create: if member() && attempt(request.resource.data, attemptId);
      // Stable IDs may be retried verbatim; scores and ownership can never change.
      allow update: if member() && resource.data.userId == request.auth.uid
        && request.resource.data == resource.data;
      allow delete: if false;
    }
    // Includes invites, inviteRevocations, feedback, rateLimits, accountDeletions,
    // appConfig and every otherwise unspecified collection. Admin clients also denied.
    match /{document=**} { allow read, write: if false; }
  }
}
